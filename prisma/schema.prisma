generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole     @default(MANAGER)
  auditLogs AuditLog[] @relation("AuditLogActor")
  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model Team {
  id            Int      @id @default(autoincrement())
  name          String
  photo         String?
  pot           Int      @default(1)
  players       Player[]
  staffs        Staff[]
  competitionId Int
  competition   Competition   @relation(fields: [competitionId], references: [id])
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  events MatchEvent[]

  createdAt     DateTime @default(now())
  deletedAt DateTime?
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String
  number    Int
  photo     String?
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  events MatchEvent[]

  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model Staff {
  id        Int      @id @default(autoincrement())
  name      String
  photo     String?
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  events MatchEvent[]

  createdAt DateTime @default(now())
  deletedAt DateTime?
}

enum UserRole {
  MANAGER
  ADMIN
}

enum CompetitionStatus {
  DRAFT
  DRAWN
  IN_PROGRESS
  FINISHED
}

model Competition {
  id        Int      @id @default(autoincrement())
  name      String
  color     String   @unique
  startDate DateTime
  teams     Team[]
  matches     Match[]
  active    Boolean @default(true)
  status    CompetitionStatus @default(DRAFT)
  // Competition format:
  // - LEAGUE: each team plays against `opponents` different opponents.
  // - GROUP: `opponents` defines the number of teams per group.
  config    CompetitionConfig
  // Number of teams that qualify for the knockout stage.
  // Must be a power of two (2, 4, 8, 16, ...).
  qualified    Int? 
  // LEAGUE: number of different opponents each team plays.
  // GROUP: number of teams in each group.
  opponents    Int?
  
  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model Match {
  id Int @id @default(autoincrement())

  competitionId Int
  competition Competition @relation(fields: [competitionId], references: [id])

  homeTeamId Int?
  homeTeam Team? @relation("HomeTeam", fields: [homeTeamId], references: [id])

  awayTeamId Int?
  awayTeam Team? @relation("AwayTeam", fields: [awayTeamId], references: [id])

  group String?
  round String

  date DateTime

  status MatchStatus @default(SCHEDULED)

  events MatchEvent[]

  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model MatchEvent {
  id Int @id @default(autoincrement())

  matchId Int
  match Match @relation(fields: [matchId], references: [id])

  teamId Int
  team Team @relation(fields: [teamId], references: [id])

  playerId Int?
  player Player? @relation(fields: [playerId], references: [id])

  staffId Int?
  staff Staff? @relation(fields: [staffId], references: [id])

  minute Int

  type MatchEventType

  createdAt DateTime @default(now())
  deletedAt DateTime?
}

enum MatchStatus {
  SCHEDULED
  
  RT_START
  RT_HALF_TIME
  RT_RESTART
  RT_END
  ET_START
  ET_HALF_TIME
  ET_RESTART
  ET_END
  PENALTIES_START
  PENALTIES_END

  INTERRUPTED
  POSTPONED
  CANCELED
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  PENALTY_GOAL
  YELLOW_CARD
  RED_CARD
}

enum CompetitionConfig {
  LEAGUE
  GROUP
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id        Int         @id @default(autoincrement())
  actorId   Int?
  actor     User?       @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String
  entityId  Int?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
